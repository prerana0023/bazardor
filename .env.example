# MongoDB Atlas connection string (database name must be in the URI)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/bazardor

# Run: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Local: http://localhost:3000 | Production: your Vercel URL
BETTER_AUTH_URL=http://localhost:3000

# Social login (optional but required by the assignment)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override API base
NEXT_PUBLIC_API_BASE_1=https://api.api-store.workers.dev/api/bazardor
